{
  "name": "texas2010-shortcuts",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "eslintConfig": {
    "extends": "@scriptable-ios"
  },
  "scripts": {
    "typecheck": "tsc -b --noEmit",
    "typecheck:build": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.vitest.json",
    "build:bundle": "vite build",
    "build-keep": "npm run typecheck && npm run build:bundle",
    "build": "npm run typecheck:build && npm run build:bundle",
    "build:watch": "vite build --watch",
    "test:watch": "vitest",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:e2e:watch": "vitest --project e2e",
    "dev": "vitest"
  },
  "author": "texas2010",
  "license": "MIT",
  "devDependencies": {
    "@scriptable-ios/eslint-config": "^1.7.0",
    "@types/node": "^25.9.1",
    "@types/scriptable-ios": "^1.7.8",
    "eslint": "^8.57.1",
    "run-applescript": "^7.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@texas2010/lib": "^0.1.0"
  }
}