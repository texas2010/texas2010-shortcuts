{
  "compilerOptions": {
    "target": "ES6",
    "useDefineForClassFields": true,
    "module": "none",
    "types": ["scriptable-ios"],
    "skipLibCheck": true,

    /* Linting */
    "strict": true,
    "alwaysStrict": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "rootDir": "src",
    "outDir": "dist",
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.test.ts", "tests/**/*", "dist/**/*", "node_modules/**/*"]
}
