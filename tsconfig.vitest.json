    "types": ["vitest/globals", "node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["vitest.config.ts", "integration/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
