{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020"],
    "types": ["vitest/globals", "node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "vitest.config.ts",
    "vitest.global-setup.ts",
    "vitest-build-status.ts",
    "integration/**/*.ts",
    "src/**/*.test.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
